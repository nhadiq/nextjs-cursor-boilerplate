# =============================================================================
# Next.js Cursor Boilerplate — environment variables
# =============================================================================
#
# Setup (fresh clone):
#   cp .env.example .env
#   openssl rand -base64 32   # paste into BETTER_AUTH_SECRET
#
# Validated at startup by src/env.ts (Zod). Empty optional values are ignored.
#
# Local dev: SQLite + in-memory rate limiting (no Upstash/Resend required).
# Vercel production: PostgreSQL + Upstash + Resend — see docs/deployment-vercel.md
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite (default for local development)
DATABASE_URL="file:./prisma/dev.db"

# PostgreSQL (production — uncomment and switch prisma/schema + src/lib/db.ts)
# See docs/postgresql.md
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# -----------------------------------------------------------------------------
# Better Auth (required)
# -----------------------------------------------------------------------------
# Min 32 characters. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-run-openssl-rand-base64-32-min-32-chars"

# App URL — must match how you access the app (no trailing slash)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Email — Resend (optional locally, required for real password reset / verification)
# -----------------------------------------------------------------------------
# Without RESEND_API_KEY, dev logs emails to the console (see src/lib/email.ts)
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# -----------------------------------------------------------------------------
# Rate limiting — Upstash Redis
# -----------------------------------------------------------------------------
# Optional for local dev and `pnpm build` (in-memory fallback in src/lib/rate-limit.ts)
# Required when VERCEL_ENV=production — set in Vercel project settings
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -----------------------------------------------------------------------------
# Google OAuth (optional)
# -----------------------------------------------------------------------------
# Set NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true only after both client ID/secret are set
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"

# -----------------------------------------------------------------------------
# Magic MCP (optional — for 21st.dev component generation in Cursor)
# -----------------------------------------------------------------------------
MAGIC_API_KEY=""

# -----------------------------------------------------------------------------
# Stripe (optional — out of scope v1, env stubs for future use)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# -----------------------------------------------------------------------------
# Runtime (usually leave unset — Next.js sets NODE_ENV automatically)
# -----------------------------------------------------------------------------
# NODE_ENV="development"
